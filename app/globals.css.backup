
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 0 0% 8%;
    --foreground: 40 20% 95%;
    --card: 0 0% 10%;
    --card-foreground: 40 20% 95%;
    --popover: 0 0% 10%;
    --popover-foreground: 40 20% 95%;
    --primary: 30 82% 58%;
    --primary-foreground: 0 0% 8%;
    --secondary: 0 0% 15%;
    --secondary-foreground: 40 20% 95%;
    --muted: 0 0% 15%;
    --muted-foreground: 40 10% 65%;
    --accent: 25 95% 60%;
    --accent-foreground: 0 0% 8%;
    --destructive: 0 75% 55%;
    --destructive-foreground: 40 20% 95%;
    --border: 0 0% 20%;
    --input: 0 0% 15%;
    --ring: 30 82% 58%;
    --radius: 0.75rem;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground font-sans;
    font-feature-settings: "rlig" 1, "calt" 1;
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  @apply bg-amber-900/20;
}

::-webkit-scrollbar-thumb {
  @apply bg-amber-700/60 rounded-full;
}

::-webkit-scrollbar-thumb:hover {
  @apply bg-amber-600/80;
}

/* Smooth scroll */
html {
  scroll-behavior: smooth;
}

/* Dark Mode Color Palette */
.text-gold { color: #d4af37; }
.text-bronze { color: #cd7f32; }
.text-copper { color: #b87333; }
.text-warm-white { color: #faf8f5; }
.text-warm-gray-light { color: #d4d1ce; }
.text-warm-gray { color: #a8a5a0; }

.bg-dark-primary { background-color: #0a0a0a; }
.bg-dark-secondary { background-color: #1a1a1a; }
.bg-dark-card { background-color: #141414; }
.bg-gold { background-color: #d4af37; }
.bg-bronze { background-color: #cd7f32; }
.bg-copper { background-color: #b87333; }

/* Gradient backgrounds for Dark Mode */
.bg-gradient-dark-warm {
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #2d1810 100%);
}

.bg-gradient-gold-warm {
  background: linear-gradient(135deg, #d4af37 0%, #cd7f32 50%, #b87333 100%);
}

.bg-gradient-bronze-warm {
  background: linear-gradient(135deg, #cd7f32 0%, #b87333 50%, #8b4513 100%);
}

